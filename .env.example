# =====================================================================
# Make Your Server — configuration (copiez ce fichier en .env à la racine)
# Le site (apps/web) et le bot (apps/bot) lisent tous deux ce fichier.
# =====================================================================

# --- Base de données PostgreSQL (16+) --------------------------------
DATABASE_URL=postgres://mys:mys@localhost:5432/mys
# Taille du pool de connexions par processus
DATABASE_POOL_SIZE=10

# --- Site ------------------------------------------------------------
# URL publique du site (sert aux redirections OAuth et aux liens du bot)
APP_URL=http://localhost:3000
# Clé de chiffrement des jetons OAuth (32 octets en base64) :
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Administrateurs : identifiants Discord séparés par des virgules.
# C’est la SEULE source du statut administrateur (aucune donnée en base ne l’accorde).
ADMIN_DISCORD_IDS=

# --- Application Discord (https://discord.com/developers/applications) ---
# Identifiant de l’application (= identifiant du bot)
DISCORD_CLIENT_ID=
# Secret OAuth2 (onglet OAuth2)
DISCORD_CLIENT_SECRET=
# Jeton du bot (onglet Bot)
DISCORD_BOT_TOKEN=
# Facultatif : serveur de développement où les commandes /mys sont enregistrées instantanément
DISCORD_DEV_GUILD_ID=
# Serveur Discord dédié aux tests réels (pnpm test:discord)
DISCORD_TEST_GUILD_ID=
# Message de bienvenue et logs d’arrivées : nécessitent l’intention privilégiée
# « Server Members » (onglet Bot). Mettez false si vous ne l’activez pas.
BOT_MEMBER_EVENTS=true

# --- Développement sans Discord ---------------------------------------
# Serveur Discord simulé et persistant (site + `pnpm --filter @mys/bot sandbox`)
DISCORD_SANDBOX=false
# Connexion de test sans Discord (ignorée si NODE_ENV=production)
DEV_LOGIN=false

# --- IA (Premium) -----------------------------------------------------
# anthropic (API payante, clé requise) ou mock (réponses simulées pour le développement)
AI_PROVIDER=anthropic
# Clé API Anthropic (https://console.anthropic.com). Un abonnement personnel Claude
# ne donne PAS accès à l’API : la consommation est facturée séparément.
ANTHROPIC_API_KEY=
# Modèle par défaut (modifiable ensuite dans Administration → IA & coûts)
AI_MODEL=claude-sonnet-5-5

# --- Paiement sur le site (Stripe) -------------------------------------
STRIPE_SECRET_KEY=
# Secret de signature du webhook /api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# L’identifiant de prix Stripe et le SKU Discord se saisissent dans
# Administration → Offres & quotas (aucun prix n’est codé en dur).

# --- Mentions légales -------------------------------------------------
# Adresse de contact affichée dans les conditions et la confidentialité
CONTACT_EMAIL=
# Éditeur du site (votre nom ou raison sociale), pour les mentions légales
LEGAL_EDITOR=
