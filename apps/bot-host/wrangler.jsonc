// Hôte du bot Discord (Cloudflare Containers). Nécessite l’offre Workers Paid.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "make-your-server-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BotContainer",
      // Image construite depuis la racine du dépôt (monorepo)
      "image": "../bot/Dockerfile",
      "image_build_context": "../..",
      // lite = 1/16 vCPU, 256 Mio. Passez à "basic" (1 Gio) si le bot manque de mémoire.
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "BotContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotContainer"] }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
