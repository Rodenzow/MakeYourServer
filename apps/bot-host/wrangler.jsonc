// Hôte du bot Discord (Cloudflare Containers). Nécessite l’offre Workers Paid.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "make-your-server-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BotContainer",
      // Conteneur géré par le Durable Object : l’image et le type d’instance (lite)
      // sont choisis au démarrage dans src/index.ts.
      "scheduling_policy": "durable_object",
      "images": {
        // Image construite depuis la racine du dépôt (monorepo)
        "bot": { "dockerfile": "../bot/Dockerfile", "build_context": "../.." }
      }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "BotContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotContainer"] }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
